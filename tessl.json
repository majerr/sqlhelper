{
  "name": "majerr/sqlhelper",
  "dependencies": {},
  "actions": {
    "shepherd-pr": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      },
      "environment": "factory-majerr-sqlhelper-shepherd"
    }
  },
  "triggers": {
    "shepherd-pr-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            13980531
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd-pr",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            13980531
          ]
        },
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd-pr",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            13980531
          ]
        },
        "isPullRequest": "true",
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd-pr",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "shepherd-pr-pr-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        },
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        }
      },
      "action": {
        "use": "shepherd-pr",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.check_run.pull_requests.0.number }}"
        }
      }
    },
    "shepherd-pr-pr-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.conclusion": "success",
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        }
      },
      "action": {
        "use": "shepherd-pr",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.check_suite.pull_requests.0.number }}"
        }
      }
    }
  }
}
